---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allEpisodes = await getCollection('offTheCuff');
  return allEpisodes.map((ep) => ({
    params: { slug: ep.data.slug },
    props: { ep },
  }));
}

const { ep } = Astro.props;
const { Content } = await render(ep);
---

<BaseLayout title={ep.data.title} description={ep.data.description}>
  <Breadcrumb crumbs={[
    { label: 'Videos', href: '/videos' },
    { label: 'Off the Cuff', href: '/videos/off-the-cuff' },
    { label: ep.data.title, href: `/videos/off-the-cuff/${ep.data.slug}` },
  ]} />
  <p class="episode-meta">
    {new Date(ep.data.publishDate).toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })} · {ep.data.series}
  </p>

  <h1>{ep.data.title}</h1>

  <p class="episode-scripture">{ep.data.scripture}</p>

  <div class="video-embed">
    <iframe
      src={`https://www.youtube.com/embed/${ep.data.youtubeId}`}
      title={ep.data.title}
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>

  <div class="episode-body">
    <Content />
  </div>
</BaseLayout>

<style>
  .video-embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin: 2rem 0;
  }

  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .episode-body {
    margin-top: 2.5rem;
  }
</style>