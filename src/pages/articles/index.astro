---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.draft !== true)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout title="Articles" description="Written teaching from God's World, God's Way.">
  <Breadcrumb crumbs={[{ label: 'Articles', href: '/articles' }]} />
  <h1>Articles</h1>

  <ul class="article-list">
    {articles.map((article) => {
      const slug = article.data.slug ?? article.id;
      return (
        <li class="article-card">
          <a href={`/articles/${slug}`} class="article-title">{article.data.title}</a>
          <p class="article-date">{formatDate(article.data.publishDate)}</p>
          <p class="article-description">{article.data.description}</p>
          <div class="tag-list">
            {article.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .article-list {
    list-style: none;
    margin-top: 2rem;
  }

  .article-card {
    border-top: 1px solid var(--color-border);
    padding: 1.75rem 0;
  }

  .article-card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    display: block;
    margin-bottom: 0.25rem;
  }

  .article-title:hover {
    color: var(--color-accent);
  }

  .article-date {
    font-size: 0.85rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
  }

  .article-description {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 3px;
    padding: 0.15rem 0.5rem;
  }
</style>
