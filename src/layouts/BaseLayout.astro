---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Reformed Bible teaching for men who want to live all of life under the lordship of Christ." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | God's World, God's Way</title>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZGB3B4SZEZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZGB3B4SZEZ');
    </script>

    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "e92c7b3a117a4cf696f268c0f25dddf5"}'></script>
  </head>
  <body>
    <header>
      <a class="site-title" href="/">God's World, God's Way</a>
      <nav>
        <a href="/videos">Videos</a>
        <a href="/articles">Articles</a>
        <a href="/books">Books</a>
        <a href="/about">About</a>
        <a href="/search">Search</a>
        <a href="/donate" class="nav-donate">Donate</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© {new Date().getFullYear()} God's World, God's Way · Sponsored by <a href="https://cr101radio.com">CR101Radio.com</a></p>
    </footer>
  </body>
</html>